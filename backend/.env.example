# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_calling_agent

# Local URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Calling mode. Keep simulated for the guaranteed browser two-way voice demo.
CALLING_PROVIDER=simulated

# GenAI - OpenRouter free router (only OPENROUTER_API_KEY must be filled)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Calling Agent
LLM_TIMEOUT_SECONDS=20

# Optional real PSTN mode. Required only for the real "Call customer’s phone" button.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ACCOUNT_TIER=upgraded
TWILIO_VOICE_MODE=gather
TWILIO_RELAY_LANGUAGE=en-IN
# Validate Twilio webhook signatures. Keep true when your public tunnel URL is stable.
TWILIO_VALIDATE_SIGNATURE=true
