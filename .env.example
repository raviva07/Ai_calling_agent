# Copy this to backend/.env, or copy backend/.env.example instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_calling_agent
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
CALLING_PROVIDER=simulated

# Free GenAI path
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Calling Agent
LLM_TIMEOUT_SECONDS=20

# Optional Twilio real-call mode (not needed for browser demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ACCOUNT_TIER=upgraded
TWILIO_VOICE_MODE=gather
TWILIO_RELAY_LANGUAGE=en-IN
# Validate Twilio webhook signatures. Keep true when your public tunnel URL is stable.
TWILIO_VALIDATE_SIGNATURE=true

# Put this one in frontend/.env.local
NEXT_PUBLIC_API_BASE=http://localhost:8000
